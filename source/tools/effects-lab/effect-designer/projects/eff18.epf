InitEqList=[loop] a = 1 | 1 | GetRandomInt(1,5);r = GetRandomReal(200, 500);sita = GetRandomReal(0, 360);xx = x0 + r * CosBJ(sita);yy = y0 + r * SinBJ(sita);x01(0) = (xx+x0)/2;y01(0) = (y0+yy)/2;R(0) = SquareRoot((x0 - x01) * (x0 - x01) + (y0 - y01) * (y0 - y01));ang(0) = bj_RADTODEG * Atan2(y0 - y01, x0 - x01);w(0) = GetRandomReal(-1, 1)>0?180:-180;delta(0) = 0;
