InitEqList=num = GetRandomInt(1, 3);sita = GetRandomReal(0, 2*bj_PI);r(0) = 60;dir(0) = GetRandomReal(-10, 10);angle(0) = bj_DEGTORAD * GetUnitFacing(caster);dis(0) = 0;[loop]j = 0 | 1 | num;sita(0) = sita + 2 * bj_PI/num;x = GetUnitX(target) - 60 * Cos(sita) * SinBJ(GetUnitFacing(caster));y = GetUnitY(target) + 60 * Cos(sita) * CosBJ(GetUnitFacing(caster));z = 150 + 60 * Sin(sita);
StuffCount=1
TransCount=0
EnableMove=1
ZRevise=0
DelayExec=0
DelayValue=0.50
EndPara=1
Para=dis
EndRelation=>=
EndValue=1000
EndwithPhase=0
MoveEqList=x = GetUnitX(target) + dis * Cos(angle) - r * Cos(sita) * Sin(angle);y = GetUnitY(target) + dis * Sin(angle) + r * Cos(sita) * Cos(angle);z= 150 + r * Sin(sita);r = r + 60 * 0.1;dis = dis + 900 * 0.1;sita = sita + 240*0.1;
