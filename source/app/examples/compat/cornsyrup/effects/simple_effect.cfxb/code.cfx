// Editable layer code — rewrite a formula and rebuild to change behavior.
// Each layer has a spawn-once `init` program and an optional per-frame `evolve` program.
// The engine's physics / timeFixed / timeVarying blobs are update-rate LOD variants of ONE
// evolve program; timeVarying is the superset, so that is what is stored here and `build`
// recompiles it into each scope the layer needs (`evolve physics` = this layer also needs
// the physics-scope copy).
//
// A layer also declares its EVENTS here: `event NAME { … }` is a kick target and `root { … }`
// is the payload a newborn receives. A payload line is just `Name` (or `Name = flags`) — Type
// and Kind are derived from the canonical particle-attribute name (Position/Orientation/
// Velocity/Color/Size/EmittedCount/…); a non-canonical name or an off-table value is written
// out in full as `Name : Type = flags kind K`. Event flags are implicit (event = 1, root = 0);
// a rare non-default is `event NAME flags N { … }`. An empty one is `event NAME;` / `root;`.
// `root auto;` means the root payload is DERIVED from the spawn graph on build.
//
// FIELD ORDER IS LOAD-BEARING: the code addresses payload elements by INDEX, so reordering
// an event's fields silently repoints every appendPayload/extractPayloadElement.

layer EmissionLayer extends EventMultiplier {
    using {
        "_t_EmissionRate" = 20.0;
    }
}

layer ParticleLayer {
    
    // @color #6EBE82
    properties {
        Renderers = [&BasicRenderer];
        sampler "SpawnShape" : Shape = &SpawnShape;
        sampler "SpreadSampler" : Shape = &SpreadSampler;
        sampler "hueSampler" : Curve = &hueSampler;
        attrib "__a_Game.TeamColor";
        metaData;
    }
    root auto;

    init {
        needs {
            "Position" : f32x3;
            "Velocity" : f32x3;
            "SpawnShape" : samplerShape_2C;
            "Size" : f32;
            "Enabled" : bool;
            "self.invLife" : f32;
            "SpreadSampler" : samplerShape_2C;
            "Sign" : f32;
            "PositionState" : f32x3;
        }

        self.invLife = rcp(1.0);

        // position space should be in world space.
        let spawnPos : f32x3 = SpawnShape.samplePosition();
        PositionState = spawnPos;
        Position = coord_space.world_base_position() + spawnPos;

        let spread : f32x3 = SpreadSampler.samplePosition();
        let initialVelocity : f32x3 = spread * #f32x3(2.0, 2.0, 0.0) + #f32x3(0.0, 0.0, 5.0);

        // Convert velocity to world space so that the particle moves in the direction of the emitter's forward vector
        Velocity = initialVelocity;
        Size = rand(0.3, 0.5);
        Sign = select(rand(0.0, 1.0) <= 0.5, 1.0, -1.0);

        Enabled = true;
    }
    evolve physics {
        needs {
            "Position" : f32x3;
            "Velocity" : f32x3;
            "self.lifeRatio" : f32;
            "__a_Game.TeamColor" : f32x4;
            "hueSampler" : samplerCurve1C;
            "Color" : f32x4;
            "Sign" : f32;
            "PositionState" : f32x3;
        }
        // Let's set the gravity here
        let gravity = #f32x3(0.0, 0.0, -9.8);

        // next we'll do a physics single integration
        physics.integrate(
            position = PositionState,
            velocity = Velocity,
            acceleration = gravity
        );

        let lifeRatio : f32 = self.lifeRatio;
        let hueDisplacement : f32 = hueSampler.sample(self.lifeRatio) * 0.2;
        let finalColor : f32x4 = color.grading(
        	rgba = __a_Game.TeamColor,
        	hsv_offset = #f32x4(Sign * hueDisplacement, 0.0, 0.0, 1.0)
        );

        Color = finalColor;

        Position = coord_space.world_base_position() + PositionState;

    }
    bind BasicRenderer {
        "Position" -> Position;
        "Size" -> SizeScale;
        "Enabled" -> Enabled;
        "Color" -> Color;
    }
}

layer RootLayer extends RootLayerTemplate {
    using {
        "_sd_eventStream" = sd0;
    }
}

layer TerminationLayer extends TerminationTemplate {
}

