// Readable sampler data (curves, shapes, textures, …). Curve keyframes are `t = value in .. out ..`
// (value/tangent arity = channel count); `build` folds them back into Times/FloatValues/FloatTangents.

sampler RootEventsSampler : EventStream {
    Times = [0];
}

sampler SnowflakesSizeCurveSampler : Curve {
    WorkspacePosition = (-836, -44);
    keys 2 {  // 1 ch, hermite
        0 = 1  in 2.2133663 out 2.2133663
        1 = 2  in 0.17527558 out 0.17527558
    }
}

