        0.36992735 = (0.8793349, 0.8793349, 1, 1)  in (-0.4343643, -0.09566441, 0, 0) out (-0.7398238, -0.16293883, 0, 0)
        1 = (0.6807812, 0.6807812, 0.9405468, 0)  in (0, 0.014492407, -0.009242585, 0) out (0, 0.02300117, -0.01466908, -3.5537202)
    }
}

