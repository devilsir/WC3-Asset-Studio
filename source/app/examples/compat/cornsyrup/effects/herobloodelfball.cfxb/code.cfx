            "internal_78fff8d1" : bool;
        }
        internal_48f679a8 = 0.0;
        self.invLife = 0.0;
        internal_78fff8d1 = false;
    }
    evolve {
        needs {
            "internal_48f679a8" : f32;
            "internal_78fff8d1" : bool;
        }
        let v1 : f32 = internal_48f679a8;
        let v2 : bool = effect.isRunning();
        let v3 : bool = lnot(v2);
        let v4 : f32 = saturate(v1 + select(v3, scene.dt, 0.0));
        self.kill(v4 == 1.0);
        let v5 : bool = internal_78fff8d1;
        let v6 : i32x3 = trigger(lnot(v5) & v3, 0.0);
        let v7 : i32 = __e_Trigger.initPayload(0, v6);
        __e_Trigger.kick(v7);
        internal_78fff8d1 = v5 | v3;
        internal_48f679a8 = v4;
    }
}

