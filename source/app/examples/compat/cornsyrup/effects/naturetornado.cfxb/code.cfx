// Editable layer code — rewrite a formula and rebuild to change behavior.
// Each layer has a spawn-once `init` program and an optional per-frame `evolve` program.
// The engine's physics / timeFixed / timeVarying blobs are update-rate LOD variants of ONE
// evolve program; timeVarying is the superset, so that is what is stored here and `build`
// recompiles it into each scope the layer needs (`evolve physics` = this layer also needs
// the physics-scope copy).
//
// A layer also declares its EVENTS here: `event NAME { … }` is a kick target and `root { … }`
// is the payload a newborn receives. A payload line is just `Name;` (or `Name = flags;`) — Type
// and Kind are derived from the canonical particle-attribute name (Position/Orientation/
// Velocity/Color/Size/EmittedCount/…); a non-canonical name or an off-table value is written
// out in full as `Name : Type = flags kind K;`. Event flags are implicit (event = 1, root = 0);
// a rare non-default is `event NAME flags N { … }`. An empty one is `event NAME;` / `root;`.
// `root auto;` means the root payload is DERIVED from the spawn graph on build.
//
// FIELD ORDER IS LOAD-BEARING: the code addresses payload elements by INDEX, so reordering
// an event's fields silently repoints every appendPayload/extractPayloadElement.

layer RootLayer extends RootLayerTemplate {
    using {
        "_sd_eventStream" = sd0;
    }
}

layer TerminationLayer extends TerminationTemplate {
    using {
        "_ev_Trigger" = __e_Trigger;
    }
    properties {
        metaData;
    }
}

layer L2 {
    properties {
        Events = [];
        NeedsEvolveOnDeath;
        metaData;
        attrib "__a_Game.EmissionRateMultiplier";
        attrib "__a_Game.SpeedMultiplier";
        attrib "__a_Game.LifespanMultiplier";
        attrib "__a_Game.ColorMultiplier";
        attrib "__a_Game.TeamColor";
        attrib "__a_Game.TargetPosition";
        attrib "__a_Game.Scale";
    }
    event __e_Child;
    event __e_OnDeath;
    root;
    init {
        needs {
            "spawnAccum" : i32x2;
        }
        self.invLife = 0.0;
        spawnAccum = #i32x2(1065353048, 0);
    }
    evolve {
        needs {
            "spawnAccum" : i32x2;
        }
        let running : bool = effect.isRunning();
        self.kill(lnot(running));
        let prevAccum : i32x2 = spawnAccum;
        // Fractional spawn-rate accumulator: 40 particles/sec, carried across frames.
        let spawnState : i32x3 = generate(prevAccum, scene.dt * (__a_Game.EmissionRateMultiplier * 40.0), 1.0, 0.0, 1.0);
        let payload : i32 = __e_Child.initPayload(0, spawnState);
        __e_Child.kick(payload);
        spawnAccum = spawnState.xy;
    }
}

layer L3 {
    properties {
        Renderers = [&rend0];
        sampler "__sampler_2" : Shape = &sd1 usage 1025;
        sampler "__sampler_4" : Curve = &sd2;
        sampler "__sampler_5" : Shape = &sd3 usage 1025;
    }
    root auto;
    init {
        needs {
            "Rotation" : f32;
            "Enabled" : bool;
            "sizeScale" : f32;
            "velocity" : f32x3;
            "position" : f32x3;
            "colorScale" : f32x4;
        }
        self.invLife = 1.6666666;
        let shapeDir : f32x3 = __sampler_2.samplePosition();
        let sizeRand : f32 = rand(0.7, 0.3);
        let rotRand : f32 = rand(0.0, 360.0);
        sizeScale = sizeRand;
        Rotation = rotRand;
        let startPos : f32x3 = __sampler_5.samplePosition();
        let colorRand : f32 = rand(1.0, 0.5);
        velocity = shapeDir * #f32x3(2.0, 2.0, 2.0);
        position = startPos;
        colorScale = colorRand.xxxx;
        Enabled = true;
    }
    evolve physics {
        needs {
            "Position" : f32x3;
            "Size" : f32;
            "Color" : f32x4;
            "TextureID" : f32;
            "scene.dt" : f32;
            "sizeScale" : f32;
            "velocity" : f32x3;
            "position" : f32x3;
            "colorScale" : f32x4;
        }
        let basePos = coord_space.world_base_position();
        let age : f32 = self.lifeRatio;
        let texId = life.select_texture_id_on_age(rend0);
        let curveColor : f32x4 = __sampler_4.sample(age);
        let l0 : f32x3 = position;
        let l1 : f32x3 = velocity;
        // p += v·t + ½·a·t², with exponential drag applied to v (l0/l1 updated in place).
        physics.integrate(
            position = l0,
            velocity = l1,
            acceleration = #f32x3(0.0, -0.0, 3.0),
            wind = #f32x3(0.0, 0.0, 0.0),
            mass = 1.0,
            drag = 1.0
        );
        let worldOffset : f32x3 = xform_l2w_d_masked(l0, 18);
        Position = basePos + worldOffset;
        Size = (age * 2.986547 + 0.5558989) * sizeScale;
        Color = curveColor * colorScale;
        TextureID = texId;
        position = l0;
        velocity = l1;
    }
    bind rend0 {
        "Position" -> Position;
        "Size" -> SizeScale;
        "Enabled" -> Enabled;
        "Rotation" -> Rotation;
        "Color" -> Color;
        "TextureID" -> TextureID;
    }
}

