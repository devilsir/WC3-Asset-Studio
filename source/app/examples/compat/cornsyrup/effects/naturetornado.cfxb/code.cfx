            "spinRate" : f32;
            "velocity" : f32x3;
            "position" : f32x3;
            "acceleration" : f32x3;
            "fadeTime" : f32;
            "sizeScale" : f32;
        }
        self.invLife = 1.4285715;
        let rotRand : f32 = rand(-45.0, 45.0);
        let spinRand : f32 = rand(10.0, 5.0);
        let startPos : f32x3 = __sampler_3.samplePosition();
        let riseRand : f32x3 = rand(#f32x3(0.0, 0.0, 1.0), #f32x3(0.0, 0.0, 6.0));
        Rotation = rotRand;
        spinRate = spinRand;
        // Same random upward vector seeds both the initial velocity and the constant accel.
        velocity = riseRand;
        position = startPos;
        acceleration = riseRand;
        fadeTime = 0.0;
        let sizeRand : f32 = rand(2.0, 3.0);
        sizeScale = sizeRand;
        Axis = #f32x3(0.0, 0.0, 0.0);
        Enabled = true;
    }
    evolve {
        needs {
            "Position" : f32x3;
            "Size" : f32;
            "Rotation" : f32;
            "NormalAxis" : f32x3;
            "Color" : f32x4;
            "spinRate" : f32;
            "velocity" : f32x3;
            "position" : f32x3;
            "acceleration" : f32x3;
            "fadeTime" : f32;
            "sizeScale" : f32;
        }
        let basePos = coord_space.world_base_position();
        let worldNormal : f32x3 = xform_l2w_d_masked(#f32x3(0.0, 0.0, 1.0), 18);
        let age : f32 = self.lifeRatio;
        let curveColor : f32x4 = __sampler_2.sample(age);
        let prevRot : f32 = Rotation;
        let sizeCurve : f32 = __sampler_5.sample(age);
        // Saturation/value push in HSV, then exposure gain.
        let gradedColor = color.grading(
            rgba = curveColor,
            hsv_offset = #f32x4(0.0, 0.13, 10.0, 0.0),
            exp_exposure = #f32x4(0.6, 0.6, 0.6, 0.6)
        );
        let prevFade : f32 = fadeTime;
        let running : bool = effect.isRunning();
        // Fade-out clock: only advances once the effect has stopped; particle dies at 1.
        let fadeElapsed : f32 = prevFade + select(lnot(running), scene.dt, 0.0);
        let fadeClamped : f32 = min(fadeElapsed, 1.0);
        self.kill(fadeClamped == 1.0);
        let fadeAlpha : f32 = __sampler_1.sample(fadeElapsed);
        let l0 : f32x3 = position;
        let l1 : f32x3 = velocity;
        // p += v·t + ½·a·t², with exponential drag applied to v (l0/l1 updated in place).
        physics.integrate(
            position = l0,
            velocity = l1,
            acceleration = acceleration,
            wind = #f32x3(0.0, 0.0, 0.0),
            mass = 1.0,
            drag = 1.5
        );
        let worldOffset : f32x3 = xform_l2w_d_masked(l0, 18);
        Position = basePos + worldOffset;
        Size = sizeCurve * 0.5 * sizeScale;
        NormalAxis = worldNormal;
        Color = gradedColor * fadeAlpha.xxxx;
        fadeTime = fadeClamped;
        Rotation = prevRot + spinRate * scene.dt;
        velocity = l1;
        position = l0;
    }
    bind rend5 {
        "Position" -> Position;
        "Size" -> SizeScale;
        "Enabled" -> Enabled;
        "Axis" -> Axis0;
        "NormalAxis" -> Axis1;
        "Rotation" -> Rotation;
        "Color" -> Color;
    }
}

layer L12 {
    properties {
        Events = [];
        NeedsEvolveOnDeath;
        metaData;
        attrib "__a_Game.EmissionRateMultiplier";
        attrib "__a_Game.SpeedMultiplier";
        attrib "__a_Game.LifespanMultiplier";
        attrib "__a_Game.ColorMultiplier";
        attrib "__a_Game.TeamColor";
        attrib "__a_Game.TargetPosition";
        attrib "__a_Game.Scale";
    }
    event __e_Child;
    event __e_OnDeath;
    root;
    init {
        needs {
            "spawnAccum" : i32x2;
        }
        self.invLife = 0.0;
        spawnAccum = #i32x2(1065353048, 0);
    }
    evolve {
        needs {
            "spawnAccum" : i32x2;
        }
        let running : bool = effect.isRunning();
        self.kill(lnot(running));
        let prevAccum : i32x2 = spawnAccum;
        // Fractional spawn-rate accumulator: 1 particle/sec, carried across frames.
        let spawnState : i32x3 = generate(prevAccum, scene.dt * Wc3.Attributes.EmissionRateMultiplier * 20.0, 1.0, 0.0, 1.0);
        let payload : i32 = __e_Child.initPayload(0, spawnState);
        __e_Child.kick(payload);
        spawnAccum = spawnState.xy;
    }
}

