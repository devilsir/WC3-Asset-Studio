layer L16 {
    properties {
        Renderers = [&rend6];
        sampler "__sampler_4" : Curve = &sd25;
        sampler "__sampler_5" : Shape = &sd26 usage 1025;
    }
    root auto;
    init {
        needs {
            "Rotation" : f32;
            "Enabled" : bool;
            "sizeScale" : f32;
            "exposure" : f32x4;
            "velocity" : f32x3;
            "position" : f32x3;
        }
        let lifeRand : f32 = rand(0.5, 0.8);
        let sizeRand : f32 = rand(0.5, 2.0);
        self.invLife = rcp(lifeRand);
        let exposureRand : f32 = rand(1.0, 0.5);
        sizeScale = sizeRand;
        let rotRand : f32 = rand(0.0, 360.0);
        exposure = exposureRand.xxxx;
        let shapeDir : f32x3 = __sampler_5.samplePosition();
        velocity = shapeDir * #f32x3(3.0, 3.0, 8.0);
        position = #f32x3(0.0, 0.0, 0.0);
        Rotation = rotRand;
        Enabled = true;
    }
    evolve physics {
        needs {
            "Position" : f32x3;
            "Size" : f32;
            "Color" : f32x4;
            "TextureID" : f32;
            "scene.dt" : f32;
            "sizeScale" : f32;
            "exposure" : f32x4;
            "velocity" : f32x3;
            "position" : f32x3;
        }
        let basePos = coord_space.world_base_position();
        let age : f32 = self.lifeRatio;
        let texId = life.select_texture_id_on_age(rend6);
        let curveColor : f32x4 = __sampler_4.sample(age);
        let l0 : f32x3 = position;
        let l1 : f32x3 = velocity;
        // p += v·t + ½·a·t², with exponential drag applied to v (l0/l1 updated in place).
        physics.integrate(
            position = l0,
            velocity = l1,
            acceleration = #f32x3(0.0, -0.0, 6.0),
            wind = #f32x3(0.0, 0.0, 0.0),
            mass = 1.0,
            drag = 1.0
        );
        let worldOffset : f32x3 = xform_l2w_d_masked(l0, 18);
        // Value-only darkening in HSV, with the per-particle random exposure.
        let gradedColor = color.grading(
            rgba = curveColor,
            hsv_offset = #f32x4(0.0, 0.0, -0.5199995, 0.0),
            exp_exposure = exposure
        );
        Position = basePos + worldOffset;
        Size = age * sizeScale;
        Color = gradedColor;
        TextureID = texId;
        velocity = l1;
        position = l0;
    }
    bind rend6 {
        "Position" -> Position;
        "Size" -> SizeScale;
        "Enabled" -> Enabled;
        "Rotation" -> Rotation;
        "Color" -> Color;
        "TextureID" -> TextureID;
    }
}

layer LeafLayer {
    properties {
        Renderers = [&LeafRenderer];
        sampler "__sampler_1" : Curve = &LeafSizeCurve;
        sampler "__sampler_2" : Shape = &LeafSpawnShape usage 1025;
        sampler "__sampler_3" : Curve = &LeafColorCurve;
    }
    root auto;
    init {
        needs {
            "Rotation" : f32;
            "Enabled" : bool;
            "TextureID" : f32;
            "hsvJitter" : f32x4;
            "spinRate" : f32;
            "orbitSpeed" : f32;
            "position" : f32x3;
            "velocity" : f32x3;
            "acceleration" : f32x3;
            "sizeScale" : f32;
        }
        let lifeRand : f32 = rand(3.0, 1.75);
        let texRand : f32 = rand(1.0, 8.0);
        self.invLife = rcp(lifeRand);
        let riseRand : f32x3 = rand(#f32x3(0.0, 0.0, 7.0), #f32x3(0.0, 0.0, 4.0));
        let shapePos : f32x3 = __sampler_2.samplePosition();
        let sizeRand : f32 = rand(0.7, 0.2);
        let rotRand : f32 = rand(0.0, 360.0);
        let spinRand : f32 = rand(0.0, 20.0);
        let hsvRand : f32x4 = rand(#f32x4(-1.0, -1.0, -1.0, -1.0), #f32x4(1.0, 1.0, 1.0, 1.0));
        // Per-particle jitter on the hue and value channels only.
        hsvJitter = hsvRand * #f32x4(0.0225, 0.0, 1.245, 0.0);
        Rotation = rotRand;
        spinRate = spinRand;
        let orbitRand : f32 = rand(0.0, 1.0);
        // Orbit rate in radians/sec, remapped to roughly 0.4π…1.0π.
        orbitSpeed = orbitRand * 1.8849558 + 1.2566371;
        position = shapePos;
        velocity = shapePos * #f32x3(2.0, 2.0, 2.0);
        acceleration = riseRand;
        sizeScale = sizeRand;
        Enabled = true;
        TextureID = texRand;
    }
    evolve physics {
        needs {
            "Position" : f32x3;
            "Size" : f32;
            "Rotation" : f32;
            "Color" : f32x4;
            "hsvJitter" : f32x4;
            "spinRate" : f32;
            "orbitSpeed" : f32;
            "position" : f32x3;
            "velocity" : f32x3;
            "acceleration" : f32x3;
            "sizeScale" : f32;
        }
        let basePos = coord_space.world_base_position();
        let age : f32 = self.lifeRatio;
        let sizeCurve : f32 = __sampler_1.sample(age);
        let curveColor : f32x4 = __sampler_3.sample(age);
        let colorHsv : f32x4 = rgb2hsv(curveColor);
        // Constant saturation/value shift in HSV, plus the per-particle jitter.
        let shiftedColor : f32x4 = hsv2rgb(colorHsv + #f32x4(0.0, -0.834, 1.0599995, 0.0) + hsvJitter);
        let dt : f32 = scene.dt;
        let prevRot : f32 = Rotation;
        let prevPos : f32x3 = position;
        // Swirl: spin the whole offset around +Z before integrating this frame's motion.
        let orbitedPos : f32x3 = radians.rotate(prevPos, #f32x3(0.0, 0.0, 1.0), dt * 0.99999994 * orbitSpeed);
        let prevVel : f32x3 = velocity;
        // Hand-rolled exponential-drag integrator, k = 3: dragDecay = e^-kt, velCoeff = (1-e^-kt)/k.
        let dragDecay : f32 = exp(neg(dt * 3.0));
        let decayOverK : f32 = dragDecay * 0.33333334;
        let velCoeff : f32x3 = (0.33333334 - decayOverK).xxx;
        let accelVec : f32x3 = acceleration;
        let newPos : f32x3 = orbitedPos + prevVel * velCoeff + accelVec * ((decayOverK - 0.33333334 + dt) * 0.33333334).xxx;
        Position = basePos + newPos;
        Size = sizeCurve * sizeScale;
        Color = shiftedColor;
        position = newPos;
        Rotation = prevRot + spinRate * dt;
        velocity = prevVel * dragDecay.xxx + accelVec * velCoeff;
    }
    bind LeafRenderer {
        "Position" -> Position;
        "Size" -> SizeScale;
        "Enabled" -> Enabled;
        "Rotation" -> Rotation;
        "Color" -> Color;
        "TextureID" -> TextureID;
    }
}

