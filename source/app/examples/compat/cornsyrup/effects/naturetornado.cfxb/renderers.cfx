// Readable renderer materials. Header: `renderer H : <Type>` where Type is the geometry
// (Billboard/Ribbon/Light/Mesh). `material = "…"` overrides the default material; a Mesh's
// model is `path = "…"`. Then one `Name = value;` per non-default property (sampler-style):
// `= "path"` = texture, `= true` = enabled, `= 1.0` = float, `= AlphaBlend` = named enum.
// Properties left at their default are OMITTED and reconstructed from the material template on
// build. Renderer INPUT bindings live in `code.cfx` (`bind rend<N> { "field" -> Slot; }`).

renderer rend0 : Billboard {
    Transparent = true;
    Diffuse = true;
    EnableRendering = true;
    SoftParticles = true;
    Atlas = true;
    BillboardingMode = ScreenAligned;
    Diffuse.DiffuseMap = "_HD.w3mod/Textures/FX/Flipbooks/FB_SmokeBlur_BW_8x8.tif";
    SoftParticles.SoftnessDistance = 0.2;
    Atlas.Source = 1;
    Atlas.SubDiv = (8, 8);
    Atlas.MotionVectorsMap = "Popcorn/Library/PopcornFXCore/Materials/DefaultTextures/Distort.dds";
}

